# Hedera operator account (e.g. 0.0.XXXXX)
HEDERA_ACCOUNT_ID=

# Raw hex ECDSA private key (secp256k1), no 0x prefix — auto-prefixed by hardhat.config.ts
HEDERA_OPERATOR_KEY_HEX=

# Hedera testnet RPC (default: https://testnet.hashio.io/api)
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# USDC HTS token ID on Hedera testnet (e.g. 0.0.8260673) — used by deploy.ts
HEDERA_USDC_TOKEN_ID=

# EVM address of the USDC HTS token — used by deploy-wallet.ts
HEDERA_USDC_TOKEN_ADDRESS=
